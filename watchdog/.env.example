# Copy this file to .env: cp .env.example .env
# .env is intentionally ignored by Git. Never publish your tokens, ntfy topic,
# webhook URLs, or heartbeat URL.

# --- required security setting ---
# Generate one with: openssl rand -hex 32
# The supplied Compose configuration refuses to start while this is empty.
WD_API_TOKEN=

# --- host and web access ---
# POOL_HOST_PATH is the btrfs pool mountpoint ON THE HOST. It is mounted at
# /pool inside the container and is also used to read the host mount table.
POOL_HOST_PATH=/zettos/pool/1
WATCHDOG_BIND_ADDRESS=0.0.0.0
WATCHDOG_PORT=8090
# Optional: use a published GHCR image instead of a local source build.
# Pin a release version rather than latest for controlled updates.
# WATCHDOG_IMAGE=ghcr.io/greyyk/nas-watchdog:1.5.0
WD_LISTEN=:8080
WD_HOST_ROOT=/host
WD_POOL_PATH=/pool
WD_INTERVAL=30s
WD_DATA_DIR=/data
WD_SMART_INTERVAL=10m
WD_LOG_INTERVAL=2m

# --- expected containers (optional) ---
# Every detected container is shown automatically. Add exact Docker names here
# only when you want an alert if one is missing or not running. Blank = no
# expected-container alerts. Example: WD_EXPECTED_CONTAINERS=plex,tailscale
WD_EXPECTED_CONTAINERS=

# --- notifications (leave blank to disable) ---
# ntfy example: WD_NTFY_URL=https://ntfy.sh
# Use a long, unguessable topic on a shared ntfy server.
WD_NTFY_URL=
WD_NTFY_TOPIC=
WD_NTFY_TOKEN=

# Generic JSON alert webhook.
WD_WEBHOOK_URL=

# Dead-man's switch, normally hosted on another machine or an external service.
WD_HEARTBEAT_URL=
WD_HEARTBEAT_INTERVAL=60s

# --- actions and guarded auto-reboot (both default off) ---
# These operations are powerful. Keep them disabled until monitoring works.
# Do not enable them without an API token and a trusted LAN/VPN boundary.
WD_ALLOW_ACTIONS=false
WD_ALLOW_REBOOT=false
WD_REBOOT_DELAY=300s
WD_REBOOT_COOLDOWN=45m
WD_REBOOT_WINDOW=30m

# --- temperature and capacity alert thresholds (degrees C / percent) ---
# Tune these for your drives and ambient conditions. Hardware-provided limits
# and alarms are reported separately and are not replaced by these values.
WD_TEMP_DIMM_WARN=60
WD_TEMP_DIMM_CRIT=70
WD_TEMP_CPU_WARN=90
WD_TEMP_CPU_CRIT=100
WD_TEMP_NVME_WARN=70
WD_TEMP_NVME_CRIT=85
WD_TEMP_HDD_WARN=50
WD_TEMP_HDD_CRIT=60
WD_TEMP_BOARD_WARN=60
WD_TEMP_BOARD_CRIT=75
WD_DISK_WARN=85
WD_DISK_CRIT=95
